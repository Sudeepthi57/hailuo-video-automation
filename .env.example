# Backend
# Hailuo _token cookie value — paste from browser DevTools (required for cloud deployment)
HAILUO_TOKEN=
# Set HEADLESS=true when deploying to a cloud server (no display)
HEADLESS=false
# Comma-separated allowed origins. Use * for local dev, or your Vercel URL in production.
# e.g. ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*

# Frontend — set in frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8001
